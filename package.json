{
  "name": "onnara-saide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.16.0",
  "description": "온나라 sAIde — 온나라 업무를 돕는 Edge AI 사이드패널.",
  "scripts": {
    "dev": "wxt -b edge",
    "prebuild": "node scripts/check-public-env.mjs",
    "build": "wxt build -b edge",
    "prezip": "node scripts/check-public-env.mjs",
    "zip": "wxt zip -b edge",
    "verify": "node scripts/verify-build.mjs && node scripts/check-contrast.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.4.5",
    "dompurify": "^3.4.13",
    "marked": "^18.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
