# 온나라 sAIde 빌드 기본값. 실제 비밀값은 이 파일에 넣지 않습니다.
# WXT_ 변수는 확장 프로그램 번들에 포함되므로 API 키 저장에 사용할 수 없습니다.

WXT_LLM_DEFAULT_PROVIDER=ollama
WXT_OLLAMA_ENDPOINT=http://127.0.0.1:11434
WXT_OLLAMA_CHAT_MODELS=gemma4:e2b
WXT_OLLAMA_EMBED_MODEL=bge-m3:latest

# 범정부 AI 공통기반은 기관 게이트웨이 주소와 공개 모델 식별자만 둡니다.
# 인증 정보는 사용자 설정 또는 기관 게이트웨이에서 주입합니다.
WXT_GOV_AI_ENDPOINT=
WXT_GOV_AI_CHAT_MODELS=

WXT_MODEL_BRIEFING=ollama:gemma4:e2b
WXT_MODEL_DISTRIBUTION=ollama:gemma4:e2b
WXT_MODEL_DRAFTING=ollama:gemma4:e2b
WXT_MODEL_PROOFREADING=ollama:gemma4:e2b
WXT_MODEL_QA=ollama:gemma4:e2b
WXT_MODEL_EMBEDDING=ollama:bge-m3:latest

# block | confirm | allow
WXT_EXTERNAL_EGRESS_POLICY=confirm
# persistent | session
WXT_LOCAL_CONTENT_RETENTION=session
# 쉼표로 구분한 온나라 허용 origin. 기관별 실제 값은 배포 시 지정합니다.
WXT_ONNARA_ORIGINS=
